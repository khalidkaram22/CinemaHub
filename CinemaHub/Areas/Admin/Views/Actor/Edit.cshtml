
@model CinemaHub.Models.Entities.Actor

@{
    ViewData["Title"] = "Edit Actor";
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header">
            <h4 class="mb-0">Edit Actor</h4>
        </div>

        <div class="card-body">

            <form asp-action="Edit" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <input type="hidden" asp-for="Id" />

                <div class="mb-3">

                    <label asp-for="Name"
                           class="form-label">
                        Actor Name
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Enter actor name" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="ImageUrl"
                           class="form-label">
                        Actor Image URL
                    </label>

                    <input asp-for="ImageUrl"
                           class="form-control"
                           placeholder="Enter actor image URL" />

                    <span asp-validation-for="ImageUrl"
                          class="text-danger">
                    </span>

                </div>

                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="mb-3">

                        <label class="form-label">
                            Current Image
                        </label>

                        <div>
                            <img src="@Model.ImageUrl"
                                 alt="@Model.Name"
                                 class="rounded"
                                 style="width:100px; height:120px; object-fit:cover;" />
                        </div>

                    </div>
                }

                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
