```cshtml
@model IEnumerable<CinemaHub.Models.Entities.Actor>

@{
    ViewData["Title"] = "Actors";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Actors</h1>

    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus"></i> Add Actor
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <h5>No actors found</h5>
                <p class="text-muted">
                    Start by creating your first actor.
                </p>

                <a asp-action="Create" class="btn btn-primary">
                    Add Actor
                </a>
            </div>
        }
        else
        {
            <table class="table table-hover align-middle mb-0">

                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Image</th>
                        <th>Actor Name</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var actor in Model)
                    {
                        <tr>

                            <td>
                                @actor.Id
                            </td>

                            <td>
                                @if (!string.IsNullOrEmpty(actor.ImageUrl))
                                {
                                    <img src="@actor.ImageUrl"
                                         alt="@actor.Name"
                                         class="rounded"
                                         style="width:70px; height:80px; object-fit:cover;" />
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No Image
                                    </span>
                                }
                            </td>

                            <td>
                                <strong>@actor.Name</strong>
                            </td>

                            <td class="text-end">

                                <a asp-action="Details"
                                   asp-route-id="@actor.Id"
                                   class="btn btn-sm btn-info">
                                    Details
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@actor.Id"
                                   class="btn btn-sm btn-warning">
                                    Edit
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@actor.Id"
                                      method="post"
                                      style="display:inline;"
                                      onsubmit="return confirm('Are you sure you want to delete this actor?');">

                                    <button type="submit"
                                            class="btn btn-sm btn-danger">
                                        Delete
                                    </button>

                                </form>

                            </td>

                        </tr>
                    }
                </tbody>

            </table>
        }

    </div>
</div>
```
