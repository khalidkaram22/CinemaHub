@model CinemaHub.Models.Entities.Cinema

@{
    ViewData["Title"] = "Create Cinema";
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header">
            <h4 class="mb-0">Create Cinema</h4>
        </div>

        <div class="card-body">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <!-- Cinema Name -->
                <div class="mb-3">

                    <label asp-for="Name"
                           class="form-label">
                        Cinema Name
                    </label>

                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Enter Cinema name" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>

                <!-- Cinema Image URL -->
                <div class="mb-3">

                    <label asp-for="ImageUrl"
                           class="form-label">
                        Cinema Image URL
                    </label>

                    <input asp-for="ImageUrl"
                           class="form-control"
                           placeholder="Enter Cinema image URL" />

                    <span asp-validation-for="ImageUrl"
                          class="text-danger">
                    </span>

                </div>

                <!-- Buttons -->
                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-primary">
                        Create
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

